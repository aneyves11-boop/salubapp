# Copiez ce fichier en ".env" puis remplissez avec les valeurs de VOTRE projet Supabase
# (Supabase → Project Settings → API).
# Le fichier .env n'est jamais envoyé sur GitHub.

VITE_SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="votre-cle-publique-anon"
VITE_SUPABASE_PROJECT_ID="VOTRE-PROJET"

# Mêmes valeurs, utilisées côté serveur (rendu SSR)
SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
